# ---- Neon Postgres ----
# Get this from https://console.neon.tech → your project → Connection Details
# Use the pooled connection string (ends with -pooler)
DATABASE_URL=postgresql://user:password@ep-something-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---- Auth.js ----
# Session signing secret. Generate with: openssl rand -base64 33
AUTH_SECRET=generate-a-long-random-string

# ---- Cron (optional, production only) ----
# Protects /api/cron/demo-reset. Vercel sends this automatically when set.
# Only needed if you use the demo accounts feature.
CRON_SECRET=generate-another-long-random-string

# ---- Local development against plain Postgres (optional) ----
# DB_DRIVER=pg
